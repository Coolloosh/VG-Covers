rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function validOptionalString(field, maxLength) {
      return !request.resource.data.keys().hasAny([field])
        || request.resource.data[field] is string
        && request.resource.data[field].size() <= maxLength;
    }

    function validProfile() {
      return request.resource.data.keys().hasOnly([
        'firstName',
        'lastName',
        'displayName',
        'email',
        'phone',
        'addressLine1',
        'addressLine2',
        'city',
        'state',
        'postalCode',
        'promoOptIn',
        'createdAt',
        'updatedAt'
      ])
      && request.resource.data.email is string
      && request.resource.data.email == request.auth.token.email
      && request.resource.data.email.size() <= 254
      && request.resource.data.promoOptIn is bool
      && request.resource.data.createdAt is timestamp
      && request.resource.data.updatedAt is timestamp
      && validOptionalString('firstName', 50)
      && validOptionalString('lastName', 50)
      && validOptionalString('displayName', 80)
      && validOptionalString('phone', 32)
      && validOptionalString('addressLine1', 120)
      && validOptionalString('addressLine2', 120)
      && validOptionalString('city', 80)
      && validOptionalString('state', 32)
      && validOptionalString('postalCode', 20);
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validProfile();
      allow update: if isOwner(userId)
        && validProfile()
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.email == resource.data.email;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
